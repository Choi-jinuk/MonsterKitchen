/* ── 오버레이 ───────────────────────────────────────────────────── */
.recipe-book-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

/* ── 패널 본체 ─────────────────────────────────────────────────── */
.recipe-book-panel {
    background-color: rgba(18, 18, 22, 0.97);
    border-radius: 14px;
    border-width: 2px;
    border-color: rgb(90, 70, 45);
    padding: 20px;
    width: 480px;
    max-height: 70%;
    min-height: 200px;
    flex-direction: column;
}

/* ── 헤더 ──────────────────────────────────────────────────────── */
.recipe-book-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.recipe-book-title {
    font-size: 20px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
}

.recipe-book-close-btn {
    width: 32px;
    height: 32px;
    font-size: 16px;
    background-color: rgba(80, 80, 80, 0.8);
    color: white;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(90, 70, 45);
}

.recipe-book-close-btn:hover {
    background-color: rgba(120, 120, 120, 0.9);
}

/* ── 카드 리스트 ────────────────────────────────────────────────── */
.recipe-card-list {
    flex-grow: 1;
}

/* ── Recipe Card ────────────────────────────────────────────────── */
.recipe-card {
    background-color: rgba(35, 35, 45, 0.95);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(70, 55, 35);
    padding: 10px 14px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
}

.recipe-card--locked {
    opacity: 0.45;
}

.recipe-card-icon {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    background-color: rgba(60, 60, 70, 1);
    margin-right: 12px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-card-info {
    flex-grow: 1;
}

.recipe-card-name {
    font-size: 15px;
    color: rgb(230, 230, 230);
    margin-bottom: 3px;
}

.recipe-card-result {
    font-size: 12px;
    color: rgb(160, 200, 255);
    margin-bottom: 3px;
}

.recipe-card-detail {
    font-size: 11px;
    color: rgb(160, 160, 160);
}

.recipe-card-mastery {
    font-size: 13px;
    color: rgb(255, 200, 50);
    margin-left: 10px;
    flex-shrink: 0;
    align-items: flex-end;
}

.recipe-card-stars {
    font-size: 14px;
    color: rgb(255, 200, 50);
}

.recipe-card-cook-count {
    font-size: 10px;
    color: rgb(140, 140, 140);
}
