<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:mk="MonsterKitchen.UI" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/CookingPanel.uss" />

    <!-- 배경 오버레이 (클릭 시 닫기) -->
    <ui:VisualElement name="cook-overlay" class="cook-overlay">

        <!-- 패널 본체 -->
        <ui:VisualElement name="cook-panel" class="cook-panel">

            <!-- 헤더 -->
            <ui:VisualElement class="cook-header">
                <mk:LocalizedLabel string-id="UI_COOKING_TITLE" class="cook-title" />
                <ui:Label name="cook-close-btn" text="✕" class="cook-close-btn" />
            </ui:VisualElement>

            <!-- 재료 슬롯 섹션 -->
            <mk:LocalizedLabel string-id="UI_COOKING_SLOTS" class="cook-section-title" />
            <ui:VisualElement name="cook-slots-row" class="cook-slots-row">
                <ui:VisualElement name="cook-slot-0" class="cook-slot cook-slot-empty">
                    <ui:VisualElement name="cook-slot-icon-0" class="cook-slot-icon" />
                    <ui:Label name="cook-slot-name-0" text="" class="cook-slot-name" />
                </ui:VisualElement>
                <ui:VisualElement name="cook-slot-1" class="cook-slot cook-slot-empty">
                    <ui:VisualElement name="cook-slot-icon-1" class="cook-slot-icon" />
                    <ui:Label name="cook-slot-name-1" text="" class="cook-slot-name" />
                </ui:VisualElement>
                <ui:VisualElement name="cook-slot-2" class="cook-slot cook-slot-empty">
                    <ui:VisualElement name="cook-slot-icon-2" class="cook-slot-icon" />
                    <ui:Label name="cook-slot-name-2" text="" class="cook-slot-name" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 레시피 매칭 결과 -->
            <ui:VisualElement class="cook-result-row">
                <ui:Label name="cook-recipe-label" text="" class="cook-recipe-label" />
                <ui:Label name="cook-btn" text="" class="cook-btn cook-btn-disabled" />
            </ui:VisualElement>

            <!-- 구분선 -->
            <ui:VisualElement class="cook-divider" />

            <!-- 인벤토리 그리드 -->
            <mk:LocalizedLabel string-id="UI_INVENTORY" class="cook-section-title" />
            <ui:ScrollView name="cook-inv-scroll" class="cook-inv-scroll" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="cook-inv-grid" class="cook-inv-grid" />
            </ui:ScrollView>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
