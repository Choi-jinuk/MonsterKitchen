<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/InventoryPanel.uss" />

    <!-- 배경 오버레이 (클릭 시 닫기) -->
    <ui:VisualElement name="inv-overlay" class="inv-overlay">

        <!-- 패널 본체 -->
        <ui:VisualElement name="inv-panel" class="inv-panel">

            <!-- 헤더 -->
            <ui:VisualElement class="inv-header">
                <ui:Label text="인벤토리" class="inv-title" />
                <ui:Label name="inv-close-btn" text="✕" class="inv-close-btn" />
            </ui:VisualElement>

            <!-- 재료 섹션 -->
            <ui:Label text="재료" class="inv-section-title" />
            <ui:ScrollView name="ing-scroll" class="inv-scroll" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="ing-grid" class="inv-grid" />
            </ui:ScrollView>

            <!-- 구분선 -->
            <ui:VisualElement class="inv-divider" />

            <!-- 음식 섹션 -->
            <ui:Label text="요리" class="inv-section-title" />
            <ui:ScrollView name="food-scroll" class="inv-scroll" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="food-grid" class="inv-grid" />
            </ui:ScrollView>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
