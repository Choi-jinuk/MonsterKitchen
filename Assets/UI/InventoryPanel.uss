/* ── 오버레이 (전체 화면 반투명 배경) ─────────────────────────── */
.inv-overlay {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

/* ── 패널 본체 ─────────────────────────────────────────────────── */
.inv-panel {
    width: 520px;
    max-height: 620px;
    background-color: rgb(28, 22, 18);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(90, 70, 45);
    padding: 20px;
    flex-direction: column;
}

/* ── 헤더 ──────────────────────────────────────────────────────── */
.inv-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.inv-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 210, 140);
}

.inv-close-btn {
    font-size: 20px;
    color: rgb(180, 150, 100);
    width: 32px;
    height: 32px;
    -unity-text-align: middle-center;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(90, 70, 45);
    background-color: rgba(255,255,255,0.05);
}

.inv-close-btn:hover {
    background-color: rgba(255,255,255,0.12);
    color: rgb(255, 255, 255);
}

/* ── 섹션 제목 ─────────────────────────────────────────────────── */
.inv-section-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(160, 130, 80);
    margin-bottom: 6px;
    margin-top: 4px;
}

/* ── 구분선 ────────────────────────────────────────────────────── */
.inv-divider {
    height: 1px;
    background-color: rgb(70, 55, 35);
    margin-top: 10px;
    margin-bottom: 10px;
}

/* ── 스크롤 뷰 ─────────────────────────────────────────────────── */
.inv-scroll {
    flex-grow: 1;
    max-height: 200px;
}

/* ── 그리드 ────────────────────────────────────────────────────── */
.inv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px;
}

/* ── 슬롯 ──────────────────────────────────────────────────────── */
.inv-slot {
    width: 72px;
    height: 72px;
    background-color: rgb(45, 35, 22);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(90, 70, 45);
    margin: 4px;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
}

.inv-slot:hover {
    border-color: rgb(200, 170, 90);
    background-color: rgb(60, 48, 30);
}

/* 아이콘 이미지 영역 */
.inv-slot-icon {
    position: absolute;
    top: 4px;
    left: 4px;
    right: 4px;
    bottom: 20px;
    -unity-background-scale-mode: scale-to-fit;
}

/* 수량 레이블 */
.inv-slot-count {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(240, 230, 200);
    -unity-text-align: middle-center;
    width: 100%;
    height: 20px;
    background-color: rgba(0,0,0,0.5);
}

/* 이름 툴팁 (슬롯 아래 표시) */
.inv-slot-name {
    font-size: 11px;
    color: rgb(200, 180, 140);
    -unity-text-align: middle-center;
    width: 72px;
    white-space: normal;
    margin-top: 2px;
}

/* 빈 인벤토리 메시지 */
.inv-empty-msg {
    font-size: 14px;
    color: rgb(120, 100, 70);
    -unity-text-align: middle-center;
    padding: 20px;
    width: 100%;
}
