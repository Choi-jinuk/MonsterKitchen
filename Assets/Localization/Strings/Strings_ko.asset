    m_Metadata:
      m_Items: []
  - m_Id: 8066
    m_Localized: "\uC800\uB141 \uC601\uC5C5 \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 8067
    m_Localized: "\uC800\uC7A5 \uC911..."
    m_Metadata:
      m_Items: []
  - m_Id: 8068
    m_Localized: "\uC624\uD06C \uC878\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 8069
    m_Localized: "\uC5D0\uBC84\uADF8\uB9B0 \uC232 \uC678\uACFD\uC744 \uBC30\uD68C\uD558\uB294
      \uD558\uAE09 \uC624\uD06C. \uBB34\uB9AC\uC9C0\uC5B4 \uB2EC\uB824\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8070
    m_Localized: "\uC624\uD06C \uC804\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 8071
    m_Localized: "\uB2E8\uB2E8\uD55C \uAC00\uC8FD \uAC11\uC637\uC744 \uB450\uB978
      \uC624\uD06C \uC804\uC0AC. \uBB35\uC9C1\uD55C \uAC15\uD0C0\uB85C \uC801\uC744
      \uBC00\uCCD0\uB0B8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8072
    m_Localized: "\uC624\uD06C \uAD11\uC804\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 8073
    m_Localized: "\uBD84\uB178\uC5D0 \uD729\uC2F8\uC778 \uC624\uD06C. \uBB34\uC12D\uAC8C
      \uB3CC\uC9C4\uD574 \uC801\uC744 \uB36E\uCE5C\uB2E4."
    m_Metadata:
      m_Items: []
