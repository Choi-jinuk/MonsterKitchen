    m_Metadata:
      m_Items: []
  - m_Id: 8055
    m_Localized: "\uC7AC\uB8CC \uC2AC\uB86F"
    m_Metadata:
      m_Items: []
  - m_Id: 8056
    m_Localized: "\uC694\uB9AC \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 8057
    m_Localized: "\uBE44\uC5B4 \uC788\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 8058
    m_Localized: "\uC7AC\uB8CC\uB97C \uC120\uD0DD\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 8059
    m_Localized: "\uC7AC\uB8CC \uC870\uD569\uC774 \uB9DE\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 8060
    m_Localized: "\uB808\uC2DC\uD53C: "
    m_Metadata:
      m_Items: []
  - m_Id: 8061
    m_Localized: "\uC7AC\uB8CC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8062
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 8063
    m_Localized: "\uC7AC\uB8CC"
    m_Metadata:
      m_Items: []
