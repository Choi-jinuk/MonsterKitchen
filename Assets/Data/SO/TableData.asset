        Ko: "\uC7AC\uB8CC\uB97C \uC120\uD0DD\uD558\uC138\uC694"
        En: Select ingredients
      - Id: 8059
        StringId: UI_COOKING_NO_MATCH
        Ko: "\uC7AC\uB8CC \uC870\uD569\uC774 \uB9DE\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4"
        En: No matching recipe
      - Id: 8060
        StringId: UI_COOKING_RECIPE_PREFIX
        Ko: "\uB808\uC2DC\uD53C: "
        En: 'Recipe:'
      - Id: 8061
        StringId: UI_COOKING_NO_INGREDIENTS
        Ko: "\uC7AC\uB8CC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
        En: No ingredients.
      - Id: 8062
        StringId: UI_INVENTORY
